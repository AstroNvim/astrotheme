[delta]
  minus-style                   = syntax "#E0BABA"
  minus-non-emph-style          = syntax "#E0BABA"
  minus-emph-style              = syntax "#EAD6D6"
  minus-empty-line-marker-style = syntax "#E0BABA"
  line-numbers-minus-style      = "#990000"
  plus-style                    = syntax "#C6D2BA"
  plus-non-emph-style           = syntax "#C6D2BA"
  plus-emph-style               = syntax "#DCE3D6"
  plus-empty-line-marker-style  = syntax "#C6D2BA"
  line-numbers-plus-style       = "#345E00"
  line-numbers-zero-style       = "#F7F8F8"
