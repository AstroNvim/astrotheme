[delta]
  minus-style                   = syntax "#E7C2C0"
  minus-non-emph-style          = syntax "#E7C2C0"
  minus-emph-style              = syntax "#F1D6D5"
  minus-empty-line-marker-style = syntax "#E7C2C0"
  line-numbers-minus-style      = "#A13F37"
  plus-style                    = syntax "#D0CFB9"
  plus-non-emph-style           = syntax "#D0CFB9"
  plus-emph-style               = syntax "#E5DDD1"
  plus-empty-line-marker-style  = syntax "#D0CFB9"
  line-numbers-plus-style       = "#467118"
  line-numbers-zero-style       = "#FEEEEE"
